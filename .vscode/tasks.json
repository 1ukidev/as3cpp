{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build server",
      "type": "shell",
      "command": "pnpm run build:server -- --debug",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": "$gcc"
    },
    {
      "label": "build extension",
      "type": "shell",
      "command": "pnpm run build",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "dependsOn": "build server",
      "problemMatcher": "$esbuild"
    }
  ]
}
